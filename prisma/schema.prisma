// Marizhaircastle — Prisma schema (MVP)
// Governed by `.agent/rules/architecture.md` and the db-migration-runner skill.
// Field names align with the Flutterwave webhook reference
// (`.agent/Skills/fluter wave intergration/resources/webhook-handler.ts`):
//   Order.paymentReference, Order.confirmedAt, Order.paidAmount, Order.totalAmount,
//   OrderItem.inventoryId/quantity, Inventory.stock.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum CustomWigStatus {
  RECEIVED
  IN_REVIEW
  CONFIRMED
  COMPLETED
  DECLINED
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(CUSTOMER)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart   Cart?
  orders Order[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  price        Decimal  @db.Decimal(10, 2)
  previousPrice Decimal? @db.Decimal(10, 2)
  // Hair-specific attributes (only set where they apply to the product).
  type         String?
  length       String?
  texture      String?
  color        String?
  careInfo     String?
  videoUrl     String?
  active       Boolean  @default(true)
  archived     Boolean  @default(false)
  categoryId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]

  @@index([categoryId])
  @@index([active])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String
  position  Int      @default(0)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  productId String

  product  Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Inventory {
  id        String   @id @default(cuid())
  stock     Int      @default(0)
  variantId String   @unique

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([stock])
}

model Cart {
  id     String  @id @default(cuid())
  userId String  @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  userId           String
  status           OrderStatus @default(PENDING_PAYMENT)
  totalAmount      Decimal     @db.Decimal(10, 2)
  paidAmount       Decimal?    @db.Decimal(10, 2)
  paymentReference String?     @unique
  confirmedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payment  Payment?
  delivery DeliveryInfo?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @unique
  flutterwaveTxnId   BigInt?       @unique
  reference          String
  status             PaymentStatus @default(PENDING)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("NGN")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model DeliveryInfo {
  id        String   @id @default(cuid())
  orderId   String   @unique
  fullName  String
  email     String
  phone     String
  address   String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model CustomWigRequest {
  id           String          @id @default(cuid())
  name         String
  email        String
  phone        String
  wigType      String
  laceSize     String
  bundles      String
  capSize      String
  length       String?
  styleInspoUrl String?
  colorInspoUrl String?
  notes        String?
  status       CustomWigStatus @default(RECEIVED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}
