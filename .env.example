# ---- Database ----
# PostgreSQL connection string (see .env.development for the real local value)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- NextAuth / Auth.js ----
# Random secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Set NEXTAUTH_URL to the app's canonical URL (http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"

# ---- Flutterwave ----
# Test (sandbox) vs live keys — confirm which before production.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""